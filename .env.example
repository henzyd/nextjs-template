# Browser-readable base URL for direct application API requests.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Browser-readable feature flag for the optional OAuth controls.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only backend base URL used by the auth bridge Route Handlers.
API_BASE_URL=https://api.example.com

# Server-only canonical app URL used to build OAuth redirects.
APP_URL=http://localhost:3000

# Server-only override. Defaults to app_auth when omitted.
AUTH_COOKIE_NAME=app_auth
